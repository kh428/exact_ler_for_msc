# Local files only. Keep source, frozen circuits, certificates and comparison
# data eligible for version control, including JSON, CSV, NPY, NPZ and GZ files.
# Figures, notebooks, requirements and dependency lockfiles are not excluded
# by extension. Put newly generated results in outputs/.
# These rules do not remove files already tracked by Git or strip metadata.

# Calculation outputs, scratch space and local caches
outputs/
/tmp/
/temp/
/scratch/
/cache/
/logs/
.cache/
.matplotlib/
*.log
*.tmp
*.temp

# Python bytecode and packaging outputs
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
/build/
/_build/
/dist/
/wheelhouse/
pip-log.txt
pip-delete-this-directory.txt

# Local Python environments; keep requirements and lockfiles
.venv/
.venv-*/
venv/
venv-*/
env/
ENV/
.tox/
.nox/
__pypackages__/
.python_history

# Test, coverage and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
.ipynb_checkpoints/

# Native binaries and compiler intermediates; keep C++ sources and build scripts
*.so
*.so.*
*.dylib
*.dll
*.pyd
*.o
*.obj
*.a
*.lib
*.exe
*.pdb
*.ilk
*.exp
*.dSYM/
a.out
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
.ninja_deps
.ninja_log
.ccache/

# Editor settings, history, swaps and backups
.vscode/
.idea/
.history/
*.code-workspace
*.sublime-workspace
*.swp
*.swo
*.swn
*~
*.bak
*.orig
*.rej
.\#*
\#*\#

# Local environment variables and credentials
# Template exceptions are for placeholders only; still review their contents.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.envrc
.direnv/
.netrc
.pypirc
.git-credentials
.ssh/
.aws/
.azure/
.gnupg/
.config/gcloud/
/secrets/
/credentials/
secrets.json
secrets.yaml
secrets.yml
secrets.toml
credentials.json
credentials.yaml
credentials.yml
credentials.toml
client_secret*.json
service-account*.json
service_account*.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
id_rsa.pub
id_dsa.pub
id_ecdsa.pub
id_ed25519.pub

# macOS / Finder and ZIP resource-fork sidecars
.DS_Store
.DS_Store?
.AppleDouble/
.LSOverride
._*
__MACOSX/
.Spotlight-V100/
.Trashes/
.TemporaryItems/
.fseventsd/

# Windows filesystem metadata
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
